{
  "name": "crawlfox/crawlfox",
  "description": "Official PHP SDK for the CrawlFox scrape and search API",
  "version": "0.1.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Crawlfox\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Crawlfox\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
