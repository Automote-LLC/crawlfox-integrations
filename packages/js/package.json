{
  "name": "crawlfox",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.2",
  "description": "Official JavaScript SDK for CrawlFox: scrape pages to markdown, search Google or DuckDuckGo, and batch URLs",
  "license": "MIT",
  "author": "Automote LLC",
  "homepage": "https://crawlfox.io",
  "bugs": {
    "url": "https://github.com/Automote-LLC/crawlfox-integrations/issues"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Automote-LLC/crawlfox-integrations.git",
    "directory": "packages/js"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "crawlfox",
    "scrape",
    "web-scraping",
    "search",
    "serp",
    "markdown",
    "batch"
  ]
}
